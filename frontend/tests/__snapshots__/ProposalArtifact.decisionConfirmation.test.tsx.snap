exports[`ProposalArtifact semantic-only confirmation enforcement > snapshot: neutral task completion includes task name and avoids legacy edit copy 1`] = `"<div class="space-y-3"><div class="space-y-2" data-testid="decision-confirmation-turn"><div class="agent-message-row"><div class="agent-chat-text text-[15px] leading-relaxed text-slate-800 dark:text-slate-200 px-1"><div class="prose prose-slate dark:prose-invert max-w-none break-words text-sm leading-relaxed"><p>I can update the status for Send court filing draft to client. Please confirm before I apply that change.</p></div></div></div><div class="rounded-xl border shadow-sm overflow-hidden border-slate-200 bg-white/90 dark:border-slate-700 dark:bg-slate-900/30" data-testid="decision-confirmation-panel" data-tone="neutral" data-state="awaiting_decision"><div class="h-1 bg-slate-500"></div><div class="px-4 py-3.5 space-y-3"><div class="space-y-1"><h3 class="text-sm font-semibold leading-5 text-slate-900 dark:text-slate-100">Confirm Status Update for Send court filing draft to client</h3><p class="text-sm leading-5 text-slate-600 dark:text-slate-300">This updates the status for Send court filing draft to client from In Progress to Completed.</p></div><div class="rounded-lg border p-3 space-y-3 bg-slate-50/70 dark:bg-slate-900/30 border-slate-200/70 dark:border-slate-700/60"><div class="space-y-2.5"><div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">What changes</div><div class="space-y-2"><div class="grid grid-cols-[minmax(96px,auto)_1fr] gap-x-3 gap-y-1 text-xs"><div class="font-medium text-slate-700 dark:text-slate-200">Status</div><div class="flex flex-wrap items-center gap-1.5"><span class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700 dark:bg-slate-800 dark:text-slate-200">In Progress</span><span class="text-slate-400 dark:text-slate-500">-&gt;</span><span class="rounded bg-slate-900 px-1.5 py-0.5 text-white dark:bg-slate-100 dark:text-slate-900">Completed</span></div></div></div></div><div class="space-y-2"><div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Can this be undone?</div><div class="space-y-1.5"><div class="flex items-start gap-2 rounded-md border px-2.5 py-2 text-xs text-slate-700 dark:text-slate-200 border-slate-200/70 bg-white/80 dark:border-slate-700/60 dark:bg-slate-900/25"><span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500"></span><span>This can be changed later if entered in error.</span></div></div></div></div><div class="flex flex-wrap gap-2 pt-1"><button type="button" class="agent-action-btn min-w-[132px] justify-center agent-action-btn-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check w-4 h-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>Set Status to Completed</button><button type="button" class="agent-action-btn agent-action-btn-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-x w-4 h-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>Keep Current Status</button></div></div></div></div></div>"`;

exports[`ProposalArtifact semantic-only confirmation enforcement > snapshot: sensitive client death confirmation renders semantic copy only 1`] = `"<div class="space-y-3"><div class="space-y-2" data-testid="decision-confirmation-turn"><div class="agent-message-row"><div class="agent-chat-text text-[15px] leading-relaxed text-slate-800 dark:text-slate-200 px-1"><div class="prose prose-slate dark:prose-invert max-w-none break-words text-sm leading-relaxed"><p>I&#x27;m sorry. I can mark Mootez Aloui as deceased so future follow-ups reflect this correctly. Please confirm before I apply that change.</p></div></div></div><div class="rounded-xl border shadow-sm overflow-hidden border-slate-300 bg-slate-50/80 dark:border-slate-700 dark:bg-slate-900/40" data-testid="decision-confirmation-panel" data-tone="sensitive" data-state="awaiting_decision"><div class="h-1 bg-slate-500"></div><div class="px-4 py-3.5 space-y-3"><div class="space-y-1"><div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Sensitive Tone</div><h3 class="text-sm font-semibold leading-5 text-slate-900 dark:text-slate-100">Mark Mootez Aloui as Deceased</h3><p class="text-sm leading-5 text-slate-600 dark:text-slate-300">You said this person has passed away. This updates the status so the assistant no longer treats them as an active client.</p></div><div class="rounded-lg border p-3 space-y-3 bg-white/70 dark:bg-slate-900/40 border-slate-200/70 dark:border-slate-700/60"><div class="space-y-2.5"><div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">What changes</div><div class="space-y-2"><div class="grid grid-cols-[minmax(96px,auto)_1fr] gap-x-3 gap-y-1 text-xs"><div class="font-medium text-slate-700 dark:text-slate-200">Status</div><div class="flex flex-wrap items-center gap-1.5"><span class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700 dark:bg-slate-800 dark:text-slate-200">Active</span><span class="text-slate-400 dark:text-slate-500">-&gt;</span><span class="rounded bg-slate-900 px-1.5 py-0.5 text-white dark:bg-slate-100 dark:text-slate-900">Deceased</span></div></div></div></div><div class="space-y-2"><div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">What this affects</div><div class="space-y-1.5"><div class="flex items-start gap-2 rounded-md border px-2.5 py-2 text-xs text-slate-700 dark:text-slate-200 border-slate-200/70 bg-white/80 dark:border-slate-700/60 dark:bg-slate-900/25"><span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500"></span><span>He will no longer appear in active-client views and routine follow-up suggestions.</span></div></div></div><div class="space-y-2"><div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Can this be undone?</div><div class="space-y-1.5"><div class="flex items-start gap-2 rounded-md border px-2.5 py-2 text-xs text-slate-700 dark:text-slate-200 border-slate-200/70 bg-white/80 dark:border-slate-700/60 dark:bg-slate-900/25"><span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500"></span><span>This can be changed later if entered in error.</span></div></div></div></div><div class="flex flex-wrap gap-2 pt-1"><button type="button" class="agent-action-btn min-w-[132px] justify-center agent-action-btn-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check w-4 h-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>Mark as Deceased</button><button type="button" class="agent-action-btn agent-action-btn-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-x w-4 h-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>Keep Current Status</button></div></div></div></div></div>"`;

exports[`ProposalArtifact semantic-only confirmation enforcement > snapshot: workflow cascade confirmation shows root diff and related examples from preview 1`] = `"<div class="space-y-3"><div class="space-y-2" data-testid="decision-confirmation-turn"><div class="agent-message-row"><div class="agent-chat-text text-[15px] leading-relaxed text-slate-800 dark:text-slate-200 px-1"><div class="prose prose-slate dark:prose-invert max-w-none break-words text-sm leading-relaxed"><p>I can update the status for Mootez Aloui, and this change is permanent. Please confirm before I apply it.</p></div></div></div><div class="rounded-xl border shadow-sm overflow-hidden border-rose-300 bg-rose-50/80 dark:border-rose-800/70 dark:bg-rose-950/20" data-testid="decision-confirmation-panel" data-tone="destructive" data-state="awaiting_decision"><div class="h-1 bg-rose-500"></div><div class="px-4 py-3.5 space-y-3"><div class="space-y-1"><div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Destructive Tone</div><h3 class="text-sm font-semibold leading-5 text-slate-900 dark:text-slate-100">Confirm Status Update for Mootez Aloui</h3><p class="text-sm leading-5 text-slate-600 dark:text-slate-300">This updates the status for Mootez Aloui from Active to Inactive.</p></div><div class="rounded-lg border p-3 space-y-3 bg-rose-50/70 dark:bg-rose-950/20 border-rose-200/70 dark:border-rose-800/60"><div class="space-y-2.5"><div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">What changes</div><div class="space-y-2"><div class="grid grid-cols-[minmax(96px,auto)_1fr] gap-x-3 gap-y-1 text-xs"><div class="font-medium text-slate-700 dark:text-slate-200">Status</div><div class="flex flex-wrap items-center gap-1.5"><span class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700 dark:bg-slate-800 dark:text-slate-200">Active</span><span class="text-slate-400 dark:text-slate-500">-&gt;</span><span class="rounded bg-slate-900