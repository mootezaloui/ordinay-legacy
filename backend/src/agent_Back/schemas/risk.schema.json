{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentOperationalRiskAnalysis",
  "description": "Operational risk analysis output. NO legal predictions, NO probability estimates, NO outcome speculation. Factual observations only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "entityRef",
    "riskScore",
    "risks",
    "summary",
    "metadata"
  ],
  "properties": {
    "type": {
      "const": "operational_risk_analysis",
      "description": "Fixed type identifier"
    },
    "entityRef": {
      "type": "object",
      "description": "Reference to the analyzed entity",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["dossier", "lawsuit", "client", "session", "task"],
          "description": "Entity type"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Entity ID"
        }
      }
    },
    "riskScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall operational risk score (0-100). Computed from detected risks, NOT predicted."
    },
    "risks": {
      "type": "array",
      "description": "Array of detected operational risks",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "severity",
          "description",
          "affectedEntityRef"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique risk identifier within this analysis"
          },
          "category": {
            "type": "string",
            "enum": [
              "DEADLINE",
              "DEPENDENCY",
              "STATE_INCONSISTENCY",
              "ACCOUNTING_GAP",
              "MISSING_DOCUMENT",
              "UNASSIGNED_RESPONSIBILITY",
              "NO_RECENT_ACTIVITY",
              "SESSION_PREPARATION_GAP"
            ],
            "description": "Risk category from operational taxonomy. ENUM ONLY. No free-text."
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"],
            "description": "Operational severity. Based on immediate impact, NOT legal consequences."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Factual description of what was detected. NO speculation about outcomes."
          },
          "affectedEntityRef": {
            "type": "object",
            "description": "Primary affected entity",
            "required": ["type", "id"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "description": "Entity type"
              },
              "id": {
                "type": ["integer", "string"],
                "description": "Entity ID"
              },
              "name": {
                "type": "string",
                "description": "Optional entity name/title for context"
              }
            }
          },
          "affectedItems": {
            "type": "array",
            "description": "Optional array of specific affected items (tasks, sessions, etc.)",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": {
                  "type": ["integer", "string"]
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          },
          "detectedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this risk was detected"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Summary statistics of detected risks",
      "required": ["total", "bySeverity", "byCategory"],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of risks detected"
        },
        "bySeverity": {
          "type": "object",
          "description": "Count of risks by severity",
          "required": ["LOW", "MEDIUM", "HIGH"],
          "additionalProperties": false,
          "properties": {
            "LOW": { "type": "integer", "minimum": 0 },
            "MEDIUM": { "type": "integer", "minimum": 0 },
            "HIGH": { "type": "integer", "minimum": 0 }
          }
        },
        "byCategory": {
          "type": "object",
          "description": "Count of risks by category",
          "additionalProperties": false,
          "patternProperties": {
            "^(DEADLINE|DEPENDENCY|STATE_INCONSISTENCY|ACCOUNTING_GAP|MISSING_DOCUMENT|UNASSIGNED_RESPONSIBILITY|NO_RECENT_ACTIVITY|SESSION_PREPARATION_GAP)$": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Analysis metadata",
      "required": ["source", "status", "requiresValidation", "analyzedAt"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["rule-based", "llm"],
          "description": "Source of analysis"
        },
        "status": {
          "type": "string",
          "const": "analysis_complete",
          "description": "Analysis status"
        },
        "requiresValidation": {
          "type": "boolean",
          "const": true,
          "description": "Always true - human must review"
        },
        "analyzedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When analysis was performed"
        }
      }
    }
  }
}
