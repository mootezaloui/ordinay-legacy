{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebSearchResults",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "query",
    "searchIntent",
    "triggeredBy",
    "provider",
    "results",
    "resultCount",
    "sources",
    "timestamp",
    "status",
    "source",
    "requires_validation"
  ],
  "properties": {
    "type": { "const": "web_search_results" },
    "query": { "type": "string", "minLength": 1 },
    "searchIntent": {
      "type": "string",
      "enum": ["WEB_SEARCH", "DEEP_SEARCH"]
    },
    "triggeredBy": {
      "type": "string",
      "enum": ["explicit_language", "button", "user_confirmed"]
    },
    "provider": { "type": "string", "minLength": 1 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "snippet", "url", "source", "publishedDate"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "snippet": { "type": "string" },
          "url": { "type": "string", "minLength": 1 },
          "source": { "type": ["string", "null"] },
          "publishedDate": { "type": ["string", "null"] }
        }
      }
    },
    "resultCount": { "type": "integer", "minimum": 0 },
    "message": { "type": ["string", "null"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType", "reference", "note"],
        "properties": {
          "sourceType": { "type": "string" },
          "reference": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "aiSummary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["shortAnswer", "keyHighlights", "citations"],
      "properties": {
        "shortAnswer": { "type": "string", "minLength": 1 },
        "keyHighlights": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "url"],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "url": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "source": { "type": "string" },
    "requires_validation": { "type": "boolean" }
  }
}
