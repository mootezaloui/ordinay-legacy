{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContextSuggestion",
  "description": "Context suggestion output for entity selection when query is ambiguous",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "message",
    "entityType",
    "suggestions",
    "timestamp",
    "source"
  ],
  "properties": {
    "type": {
      "const": "context_suggestion"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "Conversational message introducing the suggestions"
    },
    "entityType": {
      "type": "string",
      "minLength": 1,
      "description": "Type of entities being suggested"
    },
    "reason": {
      "type": "string",
      "enum": ["ambiguous_query", "missing_context", "multiple_matches"],
      "description": "Why context suggestion is needed"
    },
    "originalIntent": {
      "type": "string",
      "description": "Original intent that triggered this context suggestion"
    },
    "originalDraftType": {
      "type": "string",
      "description": "Original draft type if this was triggered by a DRAFT intent"
    },
    "originalMessage": {
      "type": "string",
      "description": "Original user message"
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entityType", "entityId", "label", "metadata", "intent", "scope"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique identifier for this suggestion"
          },
          "entityType": {
            "type": "string",
            "minLength": 1,
            "description": "Entity type"
          },
          "entityId": {
            "type": ["string", "number"],
            "description": "Entity identifier"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Display label for the entity"
          },
          "subtitle": {
            "type": ["string", "null"],
            "description": "Optional secondary text (reference, etc.)"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Structured metadata for display (overdue count, tasks, etc.)"
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "description": "Intent to execute when suggestion is selected"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clientId": { "type": "integer", "minimum": 1 },
              "dossierId": { "type": "integer", "minimum": 1 },
              "lawsuitId": { "type": "integer", "minimum": 1 },
              "sessionId": { "type": "integer", "minimum": 1 },
              "taskId": { "type": "integer", "minimum": 1 },
              "missionId": { "type": "integer", "minimum": 1 },
              "personalTaskId": { "type": "integer", "minimum": 1 },
              "financialEntryId": { "type": "integer", "minimum": 1 }
            }
          },
          "resolveContext": {
            "type": "object",
            "description": "Context resolution metadata for preserving original intent",
            "properties": {
              "originalIntent": {
                "type": "string",
                "description": "Original intent to resume after selection"
              },
              "originalDraftType": {
                "type": "string",
                "description": "Original draft type to resume after selection"
              }
            }
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "const": "rule-based"
    },
    "allowManualInput": {
      "type": "boolean",
      "description": "Whether user can manually specify an entity not in the list"
    },
    "manualInputHint": {
      "type": "string",
      "description": "Hint text for manual input option"
    }
  }
}
