{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FollowUpIntent",
  "description": "Structured follow-up intent with guaranteed scope binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "intent", "entityType", "entityId", "origin", "scope"],
  "properties": {
    "type": {
      "const": "FOLLOW_UP_INTENT"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "description": "Target READ intent to execute deterministically"
    },
    "entityType": {
      "type": "string",
      "minLength": 1,
      "description": "Origin entity type (lowercase)"
    },
    "entityId": {
      "type": ["string", "number"],
      "description": "Origin entity identifier"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "entityId"],
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1,
          "description": "Origin entity type (uppercase)"
        },
        "entityId": {
          "type": ["string", "number"],
          "description": "Origin entity identifier"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scoped entity references required to execute the follow-up",
      "properties": {
        "clientId": { "type": "integer", "minimum": 1 },
        "dossierId": { "type": "integer", "minimum": 1 },
        "lawsuitId": { "type": "integer", "minimum": 1 },
        "sessionId": { "type": "integer", "minimum": 1 },
        "taskId": { "type": "integer", "minimum": 1 },
        "missionId": { "type": "integer", "minimum": 1 },
        "personalTaskId": { "type": "integer", "minimum": 1 },
        "financialEntryId": { "type": "integer", "minimum": 1 }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional list filters for aggregate follow-ups",
      "properties": {
        "status": { "type": ["string", "null"] },
        "priority": { "type": ["string", "null"] },
        "timeframe": { "type": ["string", "null"] },
        "paymentStatus": { "type": ["string", "null"] },
        "query": { "type": ["string", "null"] },
        "overdue": { "type": ["boolean", "null"] },
        "activity": { "type": ["string", "null"] },
        "direction": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "severity": { "type": ["string", "null"] }
      }
    },
    "selectionId": {
      "type": ["string", "number"],
      "description": "Optional selection identifier for specialized flows"
    },
    "selectionCategory": {
      "type": "string",
      "description": "Optional selection category for specialized flows"
    },
    "originalIntent": {
      "type": "string",
      "description": "Original intent to resume after a selection"
    },
    "originalDraftType": {
      "type": "string",
      "description": "Original draft type to resume after a selection"
    },
    "originalMessage": {
      "type": "string",
      "description": "Original user message for resolution context"
    },
    "resolvedEntity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "id": { "type": ["string", "number"] },
        "label": { "type": "string" }
      }
    },
    "capability": {
      "type": "string",
      "description": "Optional capability selection for routing clarification"
    }
  }
}
