{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentExplanation",
  "description": "Structured entity explanation with mandatory interpretation layer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "entityId",
    "entityType",
    "facts",
    "interpretation",
    "navigation",
    "followUps",
    "timestamp",
    "sources",
    "source",
    "requires_validation",
    "status"
  ],
  "properties": {
    "type": {
      "const": "explanation"
    },
    "entityId": {
      "type": "string",
      "minLength": 1
    },
    "entityType": {
      "type": "string",
      "minLength": 1
    },

    "facts": {
      "description": "What was read — structured data points",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "details"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One-line summary of the entity"
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Key factual data points"
        }
      }
    },

    "interpretation": {
      "description": "Why it matters now — state analysis (optional when no meaningful signals)",
      "type": "object",
      "additionalProperties": false,
      "required": ["statements", "summary"],
      "properties": {
        "statements": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "statement", "implication"],
            "properties": {
              "level": {
                "type": "string",
                "enum": ["critical", "warning", "info", "neutral"]
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "description": "What the state is"
              },
              "implication": {
                "type": "string",
                "minLength": 1,
                "description": "What this means for the user"
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "description": "One-line interpretation summary"
        }
      }
    },

    "navigation": {
      "description": "Entity role context — parent/child awareness (MANDATORY)",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "roleDescription", "contextStatement"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["parent", "child", "unknown"],
          "description": "Whether this entity owns others or belongs to another"
        },
        "roleDescription": {
          "type": "string",
          "minLength": 1,
          "description": "What this entity type represents"
        },
        "contextStatement": {
          "type": "string",
          "minLength": 1,
          "description": "How to think about this entity in the workflow"
        },
        "parentPath": {
          "type": ["object", "null"],
          "description": "Reference to parent entity if this is a child",
          "properties": {
            "type": { "type": "string" },
            "id": { "type": ["string", "number"] },
            "reference": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "childrenAvailable": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "count": { "type": "number" }
            }
          },
          "description": "Available child entity types with counts"
        }
      }
    },

    "followUps": {
      "description": "Guided next steps — read-only only (MANDATORY, min 2)",
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "reason", "intent", "entityType", "entityId", "origin", "scope"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Button label"
          },
          "labelKey": {
            "type": "string",
            "description": "Deterministic label template key (non user-facing)"
          },
          "labelParams": {
            "type": "object",
            "description": "Parameters for label template",
            "additionalProperties": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why this follow-up is suggested"
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "description": "Structured READ intent to execute"
          },
          "entityType": {
            "type": "string",
            "minLength": 1,
            "description": "Origin entity type (lowercase)"
          },
          "entityId": {
            "type": ["string", "number"],
            "description": "Origin entity identifier"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity", "entityId"],
            "properties": {
              "entity": { "type": "string" },
              "entityId": { "type": ["string", "number"] }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "id": { "type": ["string", "number"] },
              "label": { "type": "string" },
              "count": { "type": "number" }
            }
          },
          "parent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": { "type": "string" },
              "id": { "type": ["string", "number"] },
              "label": { "type": "string" }
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clientId": { "type": "integer", "minimum": 1 },
              "dossierId": { "type": "integer", "minimum": 1 },
              "lawsuitId": { "type": "integer", "minimum": 1 },
              "sessionId": { "type": "integer", "minimum": 1 },
              "taskId": { "type": "integer", "minimum": 1 },
              "missionId": { "type": "integer", "minimum": 1 },
              "personalTaskId": { "type": "integer", "minimum": 1 },
              "financialEntryId": { "type": "integer", "minimum": 1 }
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": { "type": ["string", "null"] },
              "priority": { "type": ["string", "null"] },
              "timeframe": { "type": ["string", "null"] },
              "paymentStatus": { "type": ["string", "null"] },
              "query": { "type": ["string", "null"] },
              "overdue": { "type": ["boolean", "null"] },
              "activity": { "type": ["string", "null"] },
              "direction": { "type": ["string", "null"] },
              "scope": { "type": ["string", "null"] },
              "severity": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "relatedSummary": {
      "description": "Minimal summary of related child entities (counts only)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "items"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "number" }
              }
            }
          }
        }
      }
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "const": "rule-based"
    },
    "requires_validation": {
      "type": "boolean",
      "const": true
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType", "reference"],
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": ["context", "user", "system", "ledger", "database", "analysis"]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "validated"]
    }
  }
}
