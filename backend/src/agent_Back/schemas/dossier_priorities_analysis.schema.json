{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DossierPrioritiesAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "dossier",
    "counts",
    "deadlines",
    "overdue",
    "conflicts",
    "priorityRanking",
    "recommendation",
    "can_help_with",
    "timestamp",
    "source",
    "requires_validation"
  ],
  "properties": {
    "type": {
      "const": "dossier_priorities_analysis"
    },
    "dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reference", "title", "status", "priority"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "reference": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": { "type": "integer", "minimum": 0 },
        "sessions": { "type": "integer", "minimum": 0 },
        "hearings": { "type": "integer", "minimum": 0 },
        "lawsuits": { "type": "integer", "minimum": 0 },
        "financial_entries": { "type": "integer", "minimum": 0 }
      }
    },
    "deadlines": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "dueAt", "sourceType", "status", "daysUntil"],
        "properties": {
          "label": { "type": "string" },
          "dueAt": { "type": "string", "format": "date-time" },
          "sourceType": {
            "type": "string",
            "enum": ["dossier", "task", "session", "hearing", "lawsuit", "financial_entry"]
          },
          "status": { "type": "string", "enum": ["upcoming", "overdue"] },
          "daysUntil": { "type": "integer" }
        }
      }
    },
    "overdue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "byType"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "byType": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tasks": { "type": "integer", "minimum": 0 },
            "sessions": { "type": "integer", "minimum": 0 },
            "hearings": { "type": "integer", "minimum": 0 },
            "lawsuits": { "type": "integer", "minimum": 0 },
            "financial_entries": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "message": { "type": "string" }
        }
      }
    },
    "priorityRanking": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "itemType", "itemId", "label", "score", "reason"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
          "itemType": {
            "type": "string",
            "enum": ["task", "session", "hearing", "lawsuit", "financial_entry"]
          },
          "itemId": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" },
          "score": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string" },
          "dueAt": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "status": { "type": "string" }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "targetType", "targetId", "reason"],
      "properties": {
        "action": { "type": "string" },
        "targetType": {
          "type": "string",
          "enum": ["task", "session", "hearing", "lawsuit", "financial_entry", "dossier"]
        },
        "targetId": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" }
      }
    },
    "can_help_with": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "intent", "label"],
        "properties": {
          "action": { "type": "string" },
          "intent": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotAt", "scopeType", "scopeId"],
      "properties": {
        "snapshotAt": { "type": "string", "format": "date-time" },
        "scopeType": { "type": "string", "const": "dossier" },
        "scopeId": { "type": "integer", "minimum": 1 }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "requires_validation": { "type": "boolean" }
  }
}
