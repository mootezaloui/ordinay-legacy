{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "language", "targetEntity", "content"],
  "properties": {
    "documentType": { "const": "COURT_REQUEST_LETTER" },
    "schemaVersion": { "const": "1.0.0" },
    "language": { "type": "string", "enum": ["ar", "en"] },
    "targetEntity": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "integer", "minimum": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "court", "recipient", "case", "request", "dates", "signatory"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "court": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "city"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "city": { "type": "string", "minLength": 1 },
            "chamber": { "type": "string" }
          }
        },
        "recipient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "name": { "type": "string" }
          }
        },
        "case": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference"],
          "properties": {
            "reference": { "type": "string", "minLength": 1 },
            "dossierReference": { "type": "string" }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reason"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "legalReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "article"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "article": { "type": "string", "minLength": 1 },
              "excerpt": { "type": "string" }
            }
          }
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issueDate"],
          "properties": {
            "issueDate": { "type": "string", "format": "date" },
            "hearingDate": { "type": "string", "format": "date" }
          }
        },
        "signatory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "title"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "barNumber": { "type": "string" }
          }
        }
      }
    }
  }
}
