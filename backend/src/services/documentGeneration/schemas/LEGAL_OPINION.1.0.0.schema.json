{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "language", "targetEntity", "content"],
  "properties": {
    "documentType": { "const": "LEGAL_OPINION" },
    "schemaVersion": { "const": "1.0.0" },
    "language": { "type": "string", "enum": ["ar", "en"] },
    "targetEntity": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "integer", "minimum": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "issue", "analysis", "conclusion", "signatory"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "issue": { "type": "string", "minLength": 1 },
        "facts": { "type": "string" },
        "analysis": { "type": "string", "minLength": 1 },
        "conclusion": { "type": "string", "minLength": 1 },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "signatory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "title"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
