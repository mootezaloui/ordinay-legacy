{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentChat",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "message", "timestamp"],
  "properties": {
    "type": {
      "const": "chat"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["llm", "fallback"]
    }
  }
}
