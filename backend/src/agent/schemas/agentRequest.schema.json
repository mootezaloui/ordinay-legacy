{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentRequest",
  "description": "UI → Agent request contract. Defines what the UI can send to the Agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "userId",
    "agentVersion",
    "intent",
    "contextScope",
    "contextRefs",
    "userMessage",
    "language",
    "requestedAt"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^req-u[0-9]+-[0-9]+-[a-z0-9]+$",
      "description": "Unique request identifier (format: req-u{userId}-{timestamp}-{random})"
    },
    "userId": {
      "type": "integer",
      "minimum": 1,
      "description": "User ID making the request"
    },
    "agentVersion": {
      "type": "string",
      "enum": ["v1", "v2", "v3"],
      "description": "Agent version to use (determines policy and capabilities)"
    },
    "intent": {
      "type": "string",
      "enum": [
        "EXPLAIN_ENTITY_STATE",
        "SUMMARIZE_SESSION",
        "DRAFT_INVITATION",
        "DRAFT_CLIENT_EMAIL",
        "ANALYZE_OPERATIONAL_RISKS",
        "PROPOSE_ACTIONS"
      ],
      "description": "Intent from intent taxonomy (UI cannot send arbitrary intents)"
    },
    "contextScope": {
      "type": "string",
      "enum": ["GLOBAL", "CLIENT", "DOSSIER", "LAWSUIT", "SESSION", "TASK"],
      "description": "Scope of the request (determines which entities are relevant)"
    },
    "contextRefs": {
      "type": "object",
      "description": "Entity references validated based on contextScope",
      "additionalProperties": true,
      "properties": {
        "clientId": {
          "type": "integer",
          "minimum": 1,
          "description": "Client ID (required for CLIENT scope)"
        },
        "dossierId": {
          "type": "integer",
          "minimum": 1,
          "description": "Dossier ID (required for DOSSIER scope)"
        },
        "lawsuitId": {
          "type": "integer",
          "minimum": 1,
          "description": "Lawsuit ID (required for LAWSUIT scope)"
        },
        "sessionId": {
          "type": "integer",
          "minimum": 1,
          "description": "Session ID (required for SESSION scope)"
        },
        "taskId": {
          "type": "integer",
          "minimum": 1,
          "description": "Task ID (required for TASK scope)"
        }
      }
    },
    "userMessage": {
      "type": "string",
      "minLength": 1,
      "description": "User message (required, non-empty)"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "ISO 639-1 language code (e.g., 'en', 'fr')"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When request was created"
    }
  },
  "not": {
    "anyOf": [
      {
        "description": "UI cannot request execution directly",
        "type": "object",
        "properties": {
          "execute": {}
        },
        "required": ["execute"]
      },
      {
        "description": "UI cannot specify tools",
        "type": "object",
        "properties": {
          "toolName": {}
        },
        "required": ["toolName"]
      },
      {
        "description": "UI cannot specify tool parameters",
        "type": "object",
        "properties": {
          "toolParams": {}
        },
        "required": ["toolParams"]
      },
      {
        "description": "UI cannot request specific tools",
        "type": "object",
        "properties": {
          "requestedTools": {}
        },
        "required": ["requestedTools"]
      },
      {
        "description": "UI cannot bypass validation",
        "type": "object",
        "properties": {
          "bypassValidation": {}
        },
        "required": ["bypassValidation"]
      },
      {
        "description": "UI cannot override policy",
        "type": "object",
        "properties": {
          "overridePolicy": {}
        },
        "required": ["overridePolicy"]
      },
      {
        "description": "UI cannot send raw queries",
        "type": "object",
        "properties": {
          "rawQuery": {}
        },
        "required": ["rawQuery"]
      },
      {
        "description": "UI cannot execute directly",
        "type": "object",
        "properties": {
          "directExecution": {}
        },
        "required": ["directExecution"]
      }
    ]
  }
}

