{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentActionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "scope",
    "objective",
    "actions",
    "timestamp",
    "source",
    "status",
    "requires_validation"
  ],
  "properties": {
    "type": {
      "const": "action_plan"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contextReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "string",
      "const": "rule-based"
    },
    "status": {
      "type": "string",
      "const": "draft"
    },
    "requires_validation": {
      "type": "boolean",
      "const": true
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "rationale",
          "priority",
          "status",
          "requires_review",
          "risksAddressed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "blocked"
            ]
          },
          "requires_review": {
            "type": "boolean",
            "const": true
          },
          "risksAddressed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
