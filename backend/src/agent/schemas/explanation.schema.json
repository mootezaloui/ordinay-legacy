{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentExplanation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "entityId",
    "entityType",
    "summary",
    "details",
    "timestamp",
    "sources"
  ],
  "properties": {
    "type": {
      "const": "explanation"
    },
    "entityId": {
      "type": "string",
      "minLength": 1
    },
    "entityType": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceType",
          "reference"
        ],
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": [
              "context",
              "user",
              "system",
              "ledger"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validated"
      ]
    }
  }
}
