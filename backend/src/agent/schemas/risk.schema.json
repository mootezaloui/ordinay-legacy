{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentRiskAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "scope",
    "overallAssessment",
    "risks",
    "timestamp"
  ],
  "properties": {
    "type": {
      "const": "risk_analysis"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "overallAssessment": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "severity",
          "likelihood",
          "impact",
          "mitigation",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "operational",
              "legal",
              "data",
              "security",
              "financial",
              "compliance"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "likelihood": {
            "type": "string",
            "enum": [
              "rare",
              "unlikely",
              "possible",
              "likely",
              "almost_certain"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "mitigated",
              "blocked",
              "monitor"
            ]
          },
          "residualRisk": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
