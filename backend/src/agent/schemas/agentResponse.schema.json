{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentResponse",
  "description": "Agent → UI response contract. Defines what the Agent can return to the UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "responseId",
    "requestId",
    "agentVersion",
    "intent",
    "status",
    "explanation",
    "risks",
    "drafts",
    "actionProposals",
    "blockingReason",
    "errors",
    "generatedAt"
  ],
  "properties": {
    "responseId": {
      "type": "string",
      "pattern": "^res-req-u[0-9]+-[0-9]+-[a-z0-9]+-[0-9]+-[a-z0-9]+$",
      "description": "Unique response identifier"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req-u[0-9]+-[0-9]+-[a-z0-9]+$",
      "description": "Original request ID"
    },
    "agentVersion": {
      "type": "string",
      "enum": ["v1", "v2", "v3"],
      "description": "Agent version used to process request"
    },
    "intent": {
      "type": "string",
      "description": "Intent that was processed"
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "BLOCKED", "FAILED"],
      "description": "Response status (explicit, never implicit)"
    },
    "explanation": {
      "type": ["object", "null"],
      "description": "Optional explanation (schema-validated against explanation.schema.json)"
    },
    "risks": {
      "type": "array",
      "description": "Array of operational risk analyses (each validated against risk.schema.json)",
      "items": {
        "type": "object",
        "required": ["type", "entityRef", "riskScore", "risks", "summary", "metadata"],
        "properties": {
          "type": {
            "const": "operational_risk_analysis"
          },
          "entityRef": {
            "type": "object",
            "required": ["type", "id"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["dossier", "lawsuit", "client", "session", "task"]
              },
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string"
              }
            }
          },
          "riskScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "risks": {
            "type": "array"
          },
          "summary": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "drafts": {
      "type": "array",
      "description": "Array of drafts (each validated against draft.schema.json)",
      "items": {
        "type": "object",
        "required": ["type", "language", "tone", "sections", "metadata"],
        "properties": {
          "type": {
            "enum": ["INVITATION", "CLIENT_EMAIL", "HEARING_SUMMARY", "INTERNAL_NOTE"]
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "tone": {
            "type": "string"
          },
          "sections": {
            "type": "object",
            "required": ["header", "body", "footer"],
            "additionalProperties": false,
            "properties": {
              "header": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "footer": {
                "type": "string"
              }
            }
          },
          "metadata": {
            "type": "object",
            "required": ["source", "status", "requiresValidation", "createdAt"],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "requiresValidation": {
                "type": "boolean"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "actionProposals": {
      "type": "array",
      "description": "Array of action proposals (each validated against actionProposal schema)",
      "items": {
        "type": "object",
        "required": ["proposalId", "actionType", "status"],
        "properties": {
          "proposalId": {
            "type": "string"
          },
          "actionType": {
            "type": "string"
          },
          "status": {
            "enum": ["PROPOSED", "PERMITTED", "BLOCKED", "CONFIRMED", "REJECTED", "EXECUTED", "FAILED"]
          }
        }
      }
    },
    "blockingReason": {
      "type": ["string", "null"],
      "description": "Reason for BLOCKED status (required if status is BLOCKED)"
    },
    "errors": {
      "type": "array",
      "description": "Errors for FAILED status (required if status is FAILED)",
      "items": {
        "type": "object",
        "required": ["message", "code"],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "object",
            "description": "Optional error context"
          }
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When response was generated"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "blockingReason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["blockingReason"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["errors"]
      }
    }
  ],
  "not": {
    "anyOf": [
      {
        "description": "Agent cannot leak raw LLM output",
        "type": "object",
        "properties": {
          "rawLLMOutput": {}
        },
        "required": ["rawLLMOutput"]
      },
      {
        "description": "Agent cannot leak debug info",
        "type": "object",
        "properties": {
          "internalDebug": {}
        },
        "required": ["internalDebug"]
      },
      {
        "description": "Agent cannot leak tool execution trace",
        "type": "object",
        "properties": {
          "toolTrace": {}
        },
        "required": ["toolTrace"]
      },
      {
        "description": "Agent cannot send policy overrides",
        "type": "object",
        "properties": {
          "policyOverride": {}
        },
        "required": ["policyOverride"]
      },
      {
        "description": "Agent cannot send raw execution results",
        "type": "object",
        "properties": {
          "executionResult": {}
        },
        "required": ["executionResult"]
      },
      {
        "description": "Agent cannot send unvalidated content",
        "type": "object",
        "properties": {
          "unsafeContent": {}
        },
        "required": ["unsafeContent"]
      }
    ]
  }
}
