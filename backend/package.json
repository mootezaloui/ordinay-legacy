{
  "name": "ordinay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "typecheck:agent": "tsc -p tsconfig.agent.json --pretty false",
    "build:agent": "tsc -p tsconfig.agent.build.json --pretty false",
    "mcp:websearch": "node scripts/run-mcp-websearch-server.js",
    "test:agent-engine": "node --test src/agent_Back/agent.engine.test.js",
    "test:cognition": "node --test src/agent_Back/cognition/*.test.js",
    "test:mutation-governance": "node --test src/agent_Back/mutation/*.test.js",
    "test:agent-v2": "node --test src/agent/testing/tests/scenario.test.js src/agent/testing/tests/replay.test.js src/agent/testing/tests/failure.test.js src/agent/testing/tests/operations.test.js src/agent/testing/tests/getEntityGraph.test.js src/agent/testing/tests/read.audit.test.js",
    "test:agent-v2:load": "node --test src/agent/testing/tests/load.smoke.test.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "better-sqlite3": "^9.6.0",
    "canvas": "^3.2.1",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "express": "^4.19.2",
    "mammoth": "^1.12.0",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "puppeteer": "^24.3.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "nodemon": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
